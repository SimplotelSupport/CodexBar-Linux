{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodexBar",
  "version": "0.2.0-alpha",
  "identifier": "com.codexbar.linux",
  "build": {
    "frontendDist": "./dist"
  },
  "app": {
    "windows": [
      {
        "label": "popover",
        "title": "CodexBar",
        "url": "index.html",
        "width": 380,
        "height": 520,
        "minWidth": 360,
        "minHeight": 420,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "visible": false,
        "focus": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "category": "Utility",
    "shortDescription": "AI provider usage monitor",
    "longDescription": "CodexBar surfaces real-time AI coding-provider usage limits, quota reset countdowns, and cumulative cost across Codex, Claude, GitHub Copilot, OpenAI API, and OpenRouter — visible from your system tray.",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1"
        ]
      }
    }
  }
}
